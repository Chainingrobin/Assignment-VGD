  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Arena - The Offer Again
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Ganfaul
    portrait: {fileID: 21300000, guid: 924f016cfae1d9841a3816716934f22b, type: 3}
    text: Still standing? Kneel, spark, and the hurting stops. Your past is right
      here, waiting.
  choices:
  - text: Kneel and give him the elements
    setFlag: choseSubmission
    next: {fileID: 0}
  - text: Refuse. My past isn't for sale.
    setFlag: refusedOffer
    next: {fileID: 0}
  flagToSetWhenFinished: 

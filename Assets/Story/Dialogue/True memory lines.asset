MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: True memory lines
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Young Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: Rain on the roof, rain on the hill, the kettle's warm and the world is
      still...
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: Nan's song. She sang it whenever it rained. I was walking home from the
      market with her bread, singing it badly.
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: That's all it was. No destiny. No debt. Just a girl on the hill road, and
      a storm that needed somewhere to hide.
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: It was a small life. It was mine. And it isn't for sale.
  choices: []
  flagToSetWhenFinished: 

  m_Name: True memory lines
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Wulang
    portrait: {fileID: -6136380630663778560, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[I remember now. Not his version. Mine.]'
  - speaker: Wulang
    portrait: {fileID: -6136380630663778560, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[I wasn''t his vessel. I was the one who tried to stop him, and lost my
      memory doing it.]'
  - speaker: Wulang
    portrait: {fileID: -6136380630663778560, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[Whoever I was, I choose who I am now.]'

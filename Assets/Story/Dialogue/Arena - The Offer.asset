--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Arena - The Offer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: '[Abe]'
    portrait: {fileID: -2228601193727439884, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[You''ve done well, Wulang. All four elements, gathered in one vessel.
      Just as I raised you to.]'
  - speaker: Wulang
    portrait: {fileID: -6136380630663778560, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[The guardians warned me. Every memory you gave me had you at its centre.]'
  - speaker: '[Abe]'
    portrait: {fileID: -2228601193727439884, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[Because I am your past. Give me the elements and I''ll give you all of
      it back: a home, a family, a life where you mattered.]'
  - speaker: Wulang
    portrait: {fileID: -6136380630663778560, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[And if I refuse?]'
  - speaker: '[Ganfaul]'
    portrait: {fileID: -8051204198449093646, guid: 924f016cfae1d9841a3816716934f22b, type: 3}
    text: '[Then you lose everything you never had.]'
  choices:
  - text: '[Kneel and give him the elements]'
    setFlag: choseSubmission
    next: {fileID: 0}
  - text: '[Refuse. Your past is a lie]'
    setFlag: refusedOffer
    next: {fileID: 0}
  flagToSetWhenFinished: 

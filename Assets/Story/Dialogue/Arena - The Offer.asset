%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Arena - The Offer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: 'There you are. Look at you: earth, frost, flame and storm, all in one
      pair of hands. I knew you could carry them.'
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: You said you'd tell me who I was.
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: I'll do better. I'll give it back. A name people bow to. A life that mattered.
      Every memory so far was a down payment.
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: A down payment on what?
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: The elements can't be taken, spark. Only given. So give them to me, freely,
      and I'll write you a past worth having.
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: And if I say no?
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: Then I stop pretending to be Abe.
  choices:
  - text: Kneel and give him the elements
    setFlag: choseSubmission
    next: {fileID: 0}
  - text: Refuse. My past isn't for sale.
    setFlag: refusedOffer
    next: {fileID: 0}
  flagToSetWhenFinished: 

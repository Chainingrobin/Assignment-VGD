  lines:
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[Master Abe, the ground is singing!]'
  - speaker: '[Abe]'
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[Of course it is. It sings for you, and you will give its song to me.]'
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[...Did he say ''to me''? The memory flickers, and his shadow has horns.]'

  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Memory I lines
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "Hands flat on the soil, Wu. Now listen. What does it say?"
  - speaker: Young Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "It says... the soup's boiling over."
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "Ha! No. Listen again. It says the land needs someone to carry it."
  - speaker: Young Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "...It says the land needs someone to carry it."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "I don't remember any soup. Why would I remember the soup?"

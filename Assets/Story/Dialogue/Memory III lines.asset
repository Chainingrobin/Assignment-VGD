  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Memory III lines
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: Say it with me, spark. What is given freely cannot be taken.
  - speaker: Young Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: What is given freely cannot be taken.
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: And when the time comes, you'll give them to the one who raised you.
  - speaker: Young Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: Rain on the roof, rain on the hill...
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: What's that tune? Never mind it. Say it again.
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: That song. He didn't teach me that song. Someone else did.
  choices: []
  flagToSetWhenFinished: 

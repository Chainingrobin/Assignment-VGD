  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Volcano - Abe's camp
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: '[Abe]'
    portrait: {fileID: -2228601193727439884, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[The last guardian. Once you hold all four, everything will be as it should
      be.]'
  - speaker: Wulang
    portrait: {fileID: -6136380630663778560, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[As it should be for whom, Abe?]'
  - speaker: '[Abe]'
    portrait: {fileID: -2228601193727439884, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[For us, of course. Go. Ice tames fire.]'

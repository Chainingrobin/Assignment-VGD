%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Forest - Meet Abe
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "There she is. Sit, sit. You took a storm to the head, Wu. Most people don't get up from that."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "You know me?"
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "Abe. I keep this old armory, and I've kept an eye on you since you were knee-high. You don't remember? That's all right. It'll come back, I promise."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "There's lightning in my hands. Real lightning!"
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "The Storm chose you. The elements are proud: they only go where they're given. Nobody can steal them, and nobody can buy them."
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "That's what's gone wrong with the guardians. Something has them raving. The Earth guardian is tearing up the clearing south-west of here. Put it to rest, and its gift goes to whoever freed it."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "Then I'll free it. All of them, if that's what it takes."
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "Ha! That's my girl. Earth hates the storm, so hit it with everything you've got. I'm too old to fight, but I can keep you patched up."
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "Bring me Wubucks off those vampires and I'll keep you in potions. Go on, Wu. The Vale's waiting."
  choices: []
  flagToSetWhenFinished: metAbe

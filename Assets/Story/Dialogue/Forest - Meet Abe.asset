%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Forest - Meet Abe
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: '[Abe]'
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[Wulang! Thank the stars, you''re awake. Do you remember me? No... the
      corruption took that too.]'
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[I remember... nothing. Only this spark.]'
  - speaker: '[Abe]'
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[That spark is Lightning, and it''s yours. A guardian gone mad holds the
      Earth north of here. Earth fears the storm: strike it with Lightning.]'
  - speaker: '[Abe]'
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[Bring me Wubucks from those vampires and I''ll keep you in potions. Press
      H to drink one.]'
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: '[And you? Will you fight with me?]'
  - speaker: '[Abe]'
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: '[Me? I can''t touch the elements, child. That''s why I need you.]'
  choices: []
  flagToSetWhenFinished: metAbe

  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Memory II lines
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: Breathe, spark. I've got you. I've always got you.
  - speaker: Young Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: I fell through. I'm sorry. I'm sorry.
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: Don't be sorry. Be grateful. One day I'll ask you for something, and you'll
      remember this.
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: The water was warm. Ice water isn't warm.
  choices: []

MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae0ddb8bfdb069c4ca9c82f8b9852d11, type: 3}
  m_Name: Ice - Abe's camp
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "Abe! You beat me here?"
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "Old men know the long way round. Sit, warm your hands. The tea's terrible, but it's hot."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "Something came back to me at the clearing. A memory. You were in it!"
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "Was I? Good. They'll keep coming, one for every gift you carry. Let them come slowly."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "The Ice guardian is next. Any advice?"
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "It shrugs off one element at a time. Pin it with Earth, then bring the storm down on it. Together they'll shake it apart."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "How do you know all their weaknesses?"
  - speaker: Abe
    portrait: {fileID: 21300000, guid: e5ec602c4dc523c4580b750811a63e4a, type: 3}
    text: "I've watched the guardians a long time, Wu. Longer than you'd believe."
  - speaker: Wulang
    portrait: {fileID: 21300000, guid: f0fce3e3ff29277478f8abc7d81c87aa, type: 3}
    text: "Then watch this one fall."
  choices: []
  flagToSetWhenFinished: 

%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3baae2ed33aa4729afa66709a046c895, type: 3}
  m_Name: Story Text
  m_EditorClassIdentifier: Assembly-CSharp::StoryText
  chapters:
  - scene: Forest
    number: I
    title: "The Spark"
    recap: "Something drove the guardians of the Vale mad. The Storm alone got away, and hid in a girl on the hill road. She wakes with lightning in her hands and nothing else."
    lockedLine: ""
    abeGreeting: "Abe: Potions, fresh this morning. Prices are fair. Mostly."
    objectives:
    - "Speak with the old man by the armory fire"
    - "Put the Earth guardian to rest in the Blossom Glade"
    - "Take up the Earth tome"
    - "Wake the ice statue by the lake"
    - "Cross the frozen lake into the Frozen Reach"
  - scene: Ice
    number: II
    title: "What the Cold Keeps"
    recap: "The Earth guardian rests at last, and the statue has frozen the lake. Abe says the Frozen Reach is next, and that he will meet her there."
    lockedLine: "Wulang: The lake won't hold me. Not yet."
    abeGreeting: "Abe: Tea's free. Potions are not."
    objectives:
    - "Find the Ice guardian in the Frozen Amphitheater"
    - "Take up the Ice tome"
    - "Cross the mountain pass at the waystone by Abe's camp"
  - scene: Volcano
    number: III
    title: "The Price of Fire"
    recap: "Frost answers to Wulang now. Past the mountain pass, the Fire guardian has sealed the Burning Peak, and Abe is already waiting at its foot."
    lockedLine: "Wulang: The heat throws me back. The mountain is sealed."
    abeGreeting: "Abe: Last shop before the mountain. I'd stock up, spark."
    objectives:
    - "Follow the lava tube into the caldera and face the Fire guardian"
    - "Take up the Fire tome"
    - "Step into the rift at the back of the caldera"
  - scene: FinalArena
    number: IV
    title: "The Sanctum"
    recap: "Three guardians rest. Four gifts burn in one pair of hands. The rift opens on a sanctum in the sky, and Abe has gone ahead, the way he always does."
    lockedLine: ""
    abeGreeting: ""
    objectives:
    - "Find Abe at the heart of the Sanctum"
    - "Defeat Ganfaul: answer each element he takes up with its weakness"
  guardians:
  - defeatFlag: bossEarthDefeated
    displayName: "The Earth Guardian"
    introLine: "Earth Guardian: Another bearer? Another book? No more. NO MORE."
    dyingLine: "Earth Guardian: ...Lighter. The ink is gone. Carry it gently, little storm, and give it back when you are done."
  - defeatFlag: bossIceDefeated
    displayName: "The Ice Guardian"
    introLine: "Ice Guardian: Warm thing. Go home, before the cold remembers you."
    dyingLine: "Ice Guardian: The cold keeps... what warm hands forget. Ask who paid for the books, child."
  - defeatFlag: bossFireDefeated
    displayName: "The Fire Guardian"
    introLine: "Fire Guardian: Ash on the road. Ink on the stone. Turn back, storm-girl."
    dyingLine: "Fire Guardian: When they offer you a past... ask what it costs."
  - defeatFlag: bossFinalDefeated
    displayName: "Ganfaul, the Tallyman"
    introLine: "Ganfaul: Then I'll take them the slow way."
    dyingLine: "Ganfaul: Freely... given. I never could afford that."
  barks:
  - scene: Forest
    trigger: "Statue awakens"
    text: "Wulang: The statue is humming. It wants the Earth I'm carrying. (F)"
  - scene: Ice
    trigger: "Arrival"
    text: "Wulang: The wind has stopped. Everything here is holding its breath."
  - scene: Volcano
    trigger: "Arrival"
    text: "Wulang: The air itself is burning. I'll have to keep the cold close."
  lakeLine: "Wulang: The water's like knives. I can't swim this."
  lavaLine: "Wulang: Lava. Not my best idea."
  noPotionsLine: "No potions left. Abe sells them for Wubucks."
  fullHealthLine: "Wulang: I'm fine. Save it."
  ganfaulPhaseLine: "Ganfaul takes up {0}."
  memoryTitle: "A Memory Returns"
  trueMemoryTitle: "The Rain on the Hill"
  submissionTitle: "Ending: The Gilded Past"
  submissionText: "Wulang knelt, and the four gifts left her one by one. In return she was given a past: a great name, a grateful people, a teacher she owed everything. It was warm, and it fitted perfectly, and none of it was hers. Over the Vale, the rain stopped falling for free."
  truthTitle: "Ending: Freely Given"
  truthText: "Wulang walked back down through the Vale and gave the gifts back where she had found them: the earth to the glade, the cold to the reach, the fire to the mountain. She kept only the Storm, because it asked to stay. Then she went looking for a hill village, a kettle, and a woman who sang about the rain."

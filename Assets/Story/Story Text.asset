%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3baae2ed33aa4729afa66709a046c895, type: 3}
  m_Name: Story Text
  m_EditorClassIdentifier: Assembly-CSharp::StoryText
  chapters:
  - scene: Forest
    number: I
    title: "The Waking Storm"
    recap: "The Vale's four guardians have gone mad. The Storm hid inside a girl on the hill road, and she is waking up."
    lockedLine: ""
    abeGreeting: "Abe: Fresh this morning, Wu. Bitter, but they'll keep you standing."
    objectives:
    - "Talk to Abe by the fire at the armory"
    - "Follow the trail south-west to the Earth guardian"
    - "Pick up the Earth tome"
    - "Wake the ice statue by the lake"
    - "Cross the frozen lake into the snow"
  - scene: Ice
    number: II
    title: "What the Cold Keeps"
    recap: "The Earth guardian sleeps and the lake has frozen over. Abe has gone ahead into the snow."
    lockedLine: "Wulang: The lake won't hold me. Not yet."
    abeGreeting: "Abe: Tea's on, Wu. Potions too, if you need them."
    objectives:
    - "Head south to the Ice guardian's ring of stones"
    - "Pick up the Ice tome"
    - "Take the mountain path beside Abe's camp"
  - scene: Volcano
    number: III
    title: "The Price of Fire"
    recap: "Frost answers to Wulang now. Over the mountain the Fire guardian burns, and Abe waits at its foot."
    lockedLine: "Wulang: The heat throws me back. Not yet."
    abeGreeting: "Abe: Last camp before the end, Wu. Stock up. Please."
    objectives:
    - "Go through the lava tube into the volcano and face the Fire guardian"
    - "Pick up the Fire tome"
    - "Step into the rift beside Abe's camp"
  - scene: FinalArena
    number: IV
    title: "The Sanctum"
    recap: "Three guardians rest. The rift opens onto a sanctum in the sky, and Abe is already there."
    lockedLine: ""
    abeGreeting: ""
    objectives:
    - "Find Abe in the middle of the sanctum"
    - "Defeat Ganfaul: hit each element he takes with its weakness"
  guardians:
  - defeatFlag: bossEarthDefeated
    displayName: "The Earth Guardian"
    introLine: "Earth Guardian: Another bearer? Another book? No more. NO MORE."
    dyingLine: "Earth Guardian: ...Lighter. The ink is gone. Carry it gently, little storm, and give it back when you are done."
  - defeatFlag: bossIceDefeated
    displayName: "The Ice Guardian"
    introLine: "Ice Guardian: Warm thing. Go home, before the cold remembers you."
    dyingLine: "Ice Guardian: The cold keeps... what warm hands forget. Ask who paid for the books, child."
  - defeatFlag: bossFireDefeated
    displayName: "The Fire Guardian"
    introLine: "Fire Guardian: Ash on the road. Ink on the stone. Turn back, storm-girl."
    dyingLine: "Fire Guardian: When they offer you a past... ask what it costs."
  - defeatFlag: bossFinalDefeated
    displayName: "Ganfaul, the Tallyman"
    introLine: "Ganfaul: Then I'll take them the slow way."
    dyingLine: "Ganfaul: Freely... given. I never could afford that."
  barks:
  - scene: Forest
    trigger: "Statue awakens"
    text: "Wulang: The statue is humming. It wants the Earth I'm carrying. (F)"
  - scene: Ice
    trigger: "Arrival"
    text: "Wulang: Everything here is holding its breath. Hang on, guardian. I'm coming."
  - scene: Volcano
    trigger: "Arrival"
    text: "Wulang: The air itself is burning. Good thing I brought the cold."
  lakeLine: "Wulang: The water's like knives. I can't swim this."
  lavaLine: "Wulang: Lava. Not my best idea."
  riftPrompt: "Press F to enter the rift"
  riftWarning: "There is no coming back through the rift. Buy potions from Abe and finish exploring first."
  noPotionsLine: "No potions left. Abe sells them for Wubucks."
  fullHealthLine: "Wulang: I'm fine. Save it."
  ganfaulPhaseLine: "Ganfaul takes up {0}."
  memoryTitle: "A Memory Returns"
  trueMemoryTitle: "The Rain on the Hill"
  submissionTitle: "Ending: The Gilded Past"
  submissionText: "Wulang knelt, and the four gifts left her one by one. In return she was given a past: a great name, a grateful people, a teacher she owed everything. It was warm, and it fitted perfectly, and none of it was hers. Over the Vale, the rain stopped falling for free."
  truthTitle: "Ending: Freely Given"
  truthText: "Wulang walked back down through the Vale and gave the gifts back where she had found them: the earth to the glade, the cold to the snowfields, the fire to the mountain. She kept only the Storm, because it asked to stay. Then she went looking for a hill village, a kettle, and a woman who sang about the rain."

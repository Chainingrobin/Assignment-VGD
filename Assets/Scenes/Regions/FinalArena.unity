  m_GameObject: {fileID: 861582760}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 371e1ace093668542abb406922090710, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingController
  encounter: {fileID: 861582763}
  offer: {fileID: 11400000, guid: 8de79554e4bfbf247849fb7acaf347e2, type: 2}
  reOffer: {fileID: 11400000, guid: 9df3bd209dbfa594da6231557229697b, type: 2}
  submissionLines: {fileID: 11400000, guid: 0975f999e3d687f478b6538e00a9dd65, type: 2}
  trueMemory: {fileID: 1603933613}
  submissionTitle: 'Ending: The Gilded Past'
  submissionText: 'Wulang knelt, and the four gifts left her one by one. In return
    she was given a past: a great name, a grateful people, a teacher she owed everything.
    It was warm, and it fitted perfectly, and none of it was hers. Over the Vale,
    the rain stopped falling for free.'
  truthTitle: 'Ending: Freely Given'
  truthText: 'Wulang walked back down through the Vale and gave the gifts back where
    she had found them: the earth to the glade, the cold to the snowfields, the fire
    to the mountain. She kept only the Storm, because it asked to stay. Then she
    went looking for a hill village, a kettle, and a woman who sang about the rain.'
  fallFloor: 670
